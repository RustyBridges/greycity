// Every job in the city. Edit freely - the game reads this at startup.
//   tier:        0 = bottom of the ladder ... 5 = the people who never see the bottom
//   building:    which kind of building the job is at
//   spot:        where in the building they stand (Desk, Boss, Kitchen, Counter, Floor, Door)
//   start/hours: shift start hour (0-23) and length; shifts may wrap past midnight
//   wage:        paid per completed shift
//   slots:       how many people can hold this job
//   promotes_to: the next rung, if there is one
//   role:        special behaviour (Cop, Firefighter, Medic, Cook, Janitor, Cashier, Bartender, Security)
[
    // --- Diner ---
    (name: "Dishwasher",        tier: 0, building: Diner, spot: Kitchen, start: 10, hours: 8,  wage: 48,  slots: 1, promotes_to: Some("Line Cook")),
